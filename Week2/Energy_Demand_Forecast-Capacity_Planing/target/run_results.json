{"metadata": {"dbt_schema_version": "https://schemas.getdbt.com/dbt/run-results/v6.json", "dbt_version": "1.11.2", "generated_at": "2026-02-19T03:58:27.602241Z", "invocation_id": "4b3c17c1-e7c4-49d8-b2b2-b1215142ed48", "invocation_started_at": "2026-02-19T03:58:26.306755Z", "env": {}}, "results": [{"status": "success", "timing": [{"name": "compile", "started_at": "2026-02-19T03:58:27.282094Z", "completed_at": "2026-02-19T03:58:27.284100Z"}, {"name": "execute", "started_at": "2026-02-19T03:58:27.284100Z", "completed_at": "2026-02-19T03:58:27.284100Z"}], "thread_id": "Thread-2 (worker)", "execution_time": 0.010001182556152344, "adapter_response": {}, "message": null, "failures": null, "unique_id": "seed.ercot_demand_risk.ercot_load_1h", "compiled": null, "compiled_code": null, "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-02-19T03:58:27.276093Z", "completed_at": "2026-02-19T03:58:27.286094Z"}, {"name": "execute", "started_at": "2026-02-19T03:58:27.289100Z", "completed_at": "2026-02-19T03:58:27.289100Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.01600027084350586, "adapter_response": {}, "message": null, "failures": null, "unique_id": "analysis.ercot_demand_risk.sanity_checks", "compiled": true, "compiled_code": "-- analysis/data_quality_checks.sql\r\n\r\n-- Row counts\r\nSELECT\r\n  (SELECT COUNT(*) FROM ercot.raw_ercot_hourly_load) AS raw_rows,\r\n  (SELECT COUNT(*) FROM ercot.stg_ercot_load)        AS stg_rows,\r\n  (SELECT COUNT(*) FROM ercot.stg_ercot_load_1h)     AS hourly_rows;\r\n\r\n-- Null timestamps\r\nSELECT COUNT(*) AS null_hour_ts\r\nFROM ercot.stg_ercot_load\r\nWHERE hour_ts IS NULL;\r\n\r\n-- Duplicate timestamps before hourly aggregation (DST)\r\nSELECT COUNT(*) AS dup_hours\r\nFROM (\r\n  SELECT hour_ts, COUNT(*) c\r\n  FROM ercot.stg_ercot_load\r\n  GROUP BY hour_ts\r\n  HAVING c > 1\r\n);\r\n\r\n-- Range sanity\r\nSELECT MIN(hour_ts) AS min_ts, MAX(hour_ts) AS max_ts\r\nFROM ercot.stg_ercot_load_1h;", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-02-19T03:58:27.287093Z", "completed_at": "2026-02-19T03:58:27.290628Z"}, {"name": "execute", "started_at": "2026-02-19T03:58:27.290628Z", "completed_at": "2026-02-19T03:58:27.290628Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 0.004534482955932617, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.ercot_demand_risk.stg_ercot_load_1h", "compiled": true, "compiled_code": "\n\n-- Hourly ERCOT load (exported from Databricks CE, loaded via dbt seed)\n\nselect\n    cast(hour_ts as timestamp) as hour_ts,\n\n    cast(ercot_mw as double) as ercot_mw,\n    cast(coast_mw as double) as coast_mw,\n    cast(east_mw  as double) as east_mw,\n    cast(fwest_mw as double) as fwest_mw,\n    cast(north_mw as double) as north_mw,\n    cast(ncent_mw as double) as ncent_mw,\n    cast(south_mw as double) as south_mw,\n    cast(scent_mw as double) as scent_mw,\n    cast(west_mw  as double) as west_mw\n\nfrom \"ercot\".\"main\".\"ercot_load_1h\"\nwhere hour_ts is not null", "relation_name": "\"ercot\".\"main_ercot\".\"stg_ercot_load_1h\"", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-02-19T03:58:27.298862Z", "completed_at": "2026-02-19T03:58:27.314281Z"}, {"name": "execute", "started_at": "2026-02-19T03:58:27.314281Z", "completed_at": "2026-02-19T03:58:27.314281Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 0.021031856536865234, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.ercot_demand_risk.int_time_features", "compiled": true, "compiled_code": "\n\nselect\n  hour_ts,\n  extract(year from hour_ts) as year,\n  extract(month from hour_ts) as month,\n  extract(dow from hour_ts) as day_of_week,   -- DuckDB: 0=Sunday ... 6=Saturday\n  extract(hour from hour_ts) as hour_of_day,\n  case when extract(dow from hour_ts) in (0, 6) then 1 else 0 end as is_weekend\nfrom \"ercot\".\"main_ercot\".\"stg_ercot_load_1h\"", "relation_name": "\"ercot\".\"main_ercot\".\"int_time_features\"", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-02-19T03:58:27.295877Z", "completed_at": "2026-02-19T03:58:27.319347Z"}, {"name": "execute", "started_at": "2026-02-19T03:58:27.319347Z", "completed_at": "2026-02-19T03:58:27.319347Z"}], "thread_id": "Thread-2 (worker)", "execution_time": 0.02767801284790039, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.ercot_demand_risk.int_risk_thresholds_fixed", "compiled": true, "compiled_code": "\n\nwith base as (\n  select\n    hour_ts,\n    ercot_mw\n  from \"ercot\".\"main_ercot\".\"stg_ercot_load_1h\"\n  where hour_ts >= timestamp '2021-01-01'\n    and hour_ts <  timestamp '2024-01-01'\n),\n\nth as (\n  select\n    quantile_cont(ercot_mw, 0.90) as p90,\n    quantile_cont(ercot_mw, 0.95) as p95,\n    quantile_cont(ercot_mw, 0.99) as p99\n  from base\n)\n\nselect\n  p90, p95, p99,\n  '2021-01-01' as baseline_start,\n  '2024-01-01' as baseline_end\nfrom th", "relation_name": "\"ercot\".\"main_ercot\".\"int_risk_thresholds_fixed\"", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-02-19T03:58:27.304340Z", "completed_at": "2026-02-19T03:58:27.326937Z"}, {"name": "execute", "started_at": "2026-02-19T03:58:27.326937Z", "completed_at": "2026-02-19T03:58:27.326937Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 0.031059980392456055, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.ercot_demand_risk.not_null_stg_ercot_load_1h_ercot_mw.d6ade03332", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect ercot_mw\nfrom \"ercot\".\"main_ercot\".\"stg_ercot_load_1h\"\nwhere ercot_mw is null\n\n\n", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-02-19T03:58:27.301972Z", "completed_at": "2026-02-19T03:58:27.330938Z"}, {"name": "execute", "started_at": "2026-02-19T03:58:27.330938Z", "completed_at": "2026-02-19T03:58:27.330938Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.03608131408691406, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.ercot_demand_risk.assert_positive_ercot_mw", "compiled": true, "compiled_code": "select *\nfrom \"ercot\".\"main_ercot\".\"stg_ercot_load_1h\"\nwhere ercot_mw <= 0", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-02-19T03:58:27.321338Z", "completed_at": "2026-02-19T03:58:27.336943Z"}, {"name": "execute", "started_at": "2026-02-19T03:58:27.336943Z", "completed_at": "2026-02-19T03:58:27.336943Z"}], "thread_id": "Thread-2 (worker)", "execution_time": 0.01757669448852539, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.ercot_demand_risk.unique_stg_ercot_load_1h_hour_ts.63b122e7b7", "compiled": true, "compiled_code": "\n    \n    \n\nselect\n    hour_ts as unique_field,\n    count(*) as n_records\n\nfrom \"ercot\".\"main_ercot\".\"stg_ercot_load_1h\"\nwhere hour_ts is not null\ngroup by hour_ts\nhaving count(*) > 1\n\n\n", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-02-19T03:58:27.316340Z", "completed_at": "2026-02-19T03:58:27.337937Z"}, {"name": "execute", "started_at": "2026-02-19T03:58:27.339951Z", "completed_at": "2026-02-19T03:58:27.339951Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 0.024599790573120117, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.ercot_demand_risk.not_null_stg_ercot_load_1h_hour_ts.2ce713e263", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect hour_ts\nfrom \"ercot\".\"main_ercot\".\"stg_ercot_load_1h\"\nwhere hour_ts is null\n\n\n", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-02-19T03:58:27.327937Z", "completed_at": "2026-02-19T03:58:27.338939Z"}, {"name": "execute", "started_at": "2026-02-19T03:58:27.340943Z", "completed_at": "2026-02-19T03:58:27.340943Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 0.013006210327148438, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.ercot_demand_risk.int_demand_features", "compiled": true, "compiled_code": "\n\nselect\n  l.hour_ts,\n  l.ercot_mw,\n  t.year,\n  t.month,\n  t.day_of_week,\n  t.hour_of_day,\n  t.is_weekend,\n\n  lag(l.ercot_mw, 1)   over (order by l.hour_ts) as lag_1h,\n  lag(l.ercot_mw, 24)  over (order by l.hour_ts) as lag_24h,\n  lag(l.ercot_mw, 168) over (order by l.hour_ts) as lag_168h,\n\n  avg(l.ercot_mw) over (order by l.hour_ts rows between 23 preceding and current row)  as roll_mean_24h,\n  avg(l.ercot_mw) over (order by l.hour_ts rows between 167 preceding and current row) as roll_mean_7d\n\nfrom \"ercot\".\"main_ercot\".\"stg_ercot_load_1h\" l\njoin \"ercot\".\"main_ercot\".\"int_time_features\" t\n  on l.hour_ts = t.hour_ts", "relation_name": "\"ercot\".\"main_ercot\".\"int_demand_features\"", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-02-19T03:58:27.332995Z", "completed_at": "2026-02-19T03:58:27.338939Z"}, {"name": "execute", "started_at": "2026-02-19T03:58:27.340943Z", "completed_at": "2026-02-19T03:58:27.340943Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.008975744247436523, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.ercot_demand_risk.not_null_int_time_features_hour_ts.ab3c2b0cbb", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect hour_ts\nfrom \"ercot\".\"main_ercot\".\"int_time_features\"\nwhere hour_ts is null\n\n\n", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-02-19T03:58:27.343938Z", "completed_at": "2026-02-19T03:58:27.400183Z"}, {"name": "execute", "started_at": "2026-02-19T03:58:27.405177Z", "completed_at": "2026-02-19T03:58:27.405177Z"}], "thread_id": "Thread-2 (worker)", "execution_time": 0.06522607803344727, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.ercot_demand_risk.unique_int_time_features_hour_ts.ab4d2125a0", "compiled": true, "compiled_code": "\n    \n    \n\nselect\n    hour_ts as unique_field,\n    count(*) as n_records\n\nfrom \"ercot\".\"main_ercot\".\"int_time_features\"\nwhere hour_ts is not null\ngroup by hour_ts\nhaving count(*) > 1\n\n\n", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-02-19T03:58:27.396169Z", "completed_at": "2026-02-19T03:58:27.410248Z"}, {"name": "execute", "started_at": "2026-02-19T03:58:27.411257Z", "completed_at": "2026-02-19T03:58:27.411257Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 0.02378225326538086, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.ercot_demand_risk.not_null_int_risk_thresholds_fixed_baseline_end.bae26c9338", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect baseline_end\nfrom \"ercot\".\"main_ercot\".\"int_risk_thresholds_fixed\"\nwhere baseline_end is null\n\n\n", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-02-19T03:58:27.390257Z", "completed_at": "2026-02-19T03:58:27.415257Z"}, {"name": "execute", "started_at": "2026-02-19T03:58:27.416284Z", "completed_at": "2026-02-19T03:58:27.416284Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 0.028809309005737305, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.ercot_demand_risk.fct_capacity_risk", "compiled": true, "compiled_code": "\n\nwith th as (\n  select * from \"ercot\".\"main_ercot\".\"int_risk_thresholds_fixed\"\n),\nl as (\n  select\n    hour_ts,\n    ercot_mw\n  from \"ercot\".\"main_ercot\".\"stg_ercot_load_1h\"\n)\n\nselect\n  l.hour_ts,\n  l.ercot_mw,\n  case\n    when l.ercot_mw >= th.p99 then 'EXTREME'\n    when l.ercot_mw >= th.p95 then 'HIGH'\n    when l.ercot_mw >= th.p90 then 'MEDIUM'\n    else 'LOW'\n  end as risk_level,\n  th.p90, th.p95, th.p99,\n  th.baseline_start,\n  th.baseline_end\nfrom l\ncross join th", "relation_name": "\"ercot\".\"main_ercot\".\"fct_capacity_risk\"", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-02-19T03:58:27.407247Z", "completed_at": "2026-02-19T03:58:27.420309Z"}, {"name": "execute", "started_at": "2026-02-19T03:58:27.421261Z", "completed_at": "2026-02-19T03:58:27.421261Z"}], "thread_id": "Thread-2 (worker)", "execution_time": 0.01502537727355957, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.ercot_demand_risk.not_null_int_risk_thresholds_fixed_p90.350c5b4e30", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect p90\nfrom \"ercot\".\"main_ercot\".\"int_risk_thresholds_fixed\"\nwhere p90 is null\n\n\n", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-02-19T03:58:27.401224Z", "completed_at": "2026-02-19T03:58:27.425258Z"}, {"name": "execute", "started_at": "2026-02-19T03:58:27.425258Z", "completed_at": "2026-02-19T03:58:27.425258Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.037813425064086914, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.ercot_demand_risk.not_null_int_risk_thresholds_fixed_baseline_start.9342b95d55", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect baseline_start\nfrom \"ercot\".\"main_ercot\".\"int_risk_thresholds_fixed\"\nwhere baseline_start is null\n\n\n", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-02-19T03:58:27.417255Z"